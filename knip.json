{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["poetry"],
  "ignoreDependencies": ["tailwindcss-animate"],
  "workspaces": {
    ".": {
      "entry": [
        "src/index.html",
        "src/pages/Splash/splash.html",
        "src/pages/Splash/splash-entry.jsx",
        "scripts/**/*.{js,mjs}",
        "test/mocha/default/*.test.js",
        "test/mocha/supplemental/*.test.js",
        "test/vitest/domain/**/*.test.{js,ts}",
        "test/vitest/integration/**/*.test.{js,ts}"
      ],
      "project": ["src/**/*.{js,jsx,ts,tsx}", "scripts/**/*.{js,mjs}"]
    },
    "electron-app": {
      "entry": ["preload.js", "splash-preload.js"],
      "project": ["**/*.js"],
      "ignoreDependencies": ["electron-builder"]
    }
  }
}
